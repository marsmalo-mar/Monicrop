{
  "name": "monicrop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local scripts/setup-db.mjs",
    "db:bootstrap-admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "demo:setup": "node --env-file=.env.demo.local scripts/demo.mjs setup",
    "demo:dev": "node --env-file=.env.demo.local scripts/demo.mjs dev",
    "demo:build": "node --env-file=.env.demo.local scripts/demo.mjs build",
    "demo:start": "node --env-file=.env.demo.local scripts/demo.mjs start",
    "demo:test": "node --env-file=.env.demo.local scripts/demo.mjs test",
    "repo:check": "node scripts/check-repository.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node --env-file=.env.local scripts/verify.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.0.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.0.0"
  }
}
